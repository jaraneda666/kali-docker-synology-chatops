# Configuración de variables de entorno para Kali Linux en Synology Docker

# Identificadores de usuario en Synology DSM (verificar con id <usuario> vía SSH)
PUID=1026
PGID=100
TZ=America/Santiago

# Credenciales de acceso Web Desktop (KasmVNC / noVNC)
KALI_USER=kali
KALI_PASS=CambiarEstaClaveSegura2026!

# Credenciales de acceso Web Terminal (ttyd)
TTYD_USER=kali
TTYD_PASS=CambiarEstaClaveSegura2026!

# Red macvlan
MACVLAN_PARENT=eth0
KALI_IP=192.168.50.80
TTYD_IP=192.168.50.81
SUBNET=192.168.50.0/24
GATEWAY=192.168.50.1

# Parámetros del Bot de Telegram (para servicio Python / n8n)
TELEGRAM_BOT_TOKEN=tu_token_aqui
TELEGRAM_ALLOWED_USER_ID=tu_chat_id_aqui
